[
  /* Bar for inbuilt laptop display */
  {
  "name": "inbuilt",
  "layer": "bottom",
  "position": "top",
  "height": 16,
  "spacing": 3,
  "margin-top": 1,
  "margin-left": 2,
  "margin-right": 2,
  "output": ["eDP-1"],
  "modules-left": [
    "custom/fuzzel",
    "hyprland/workspaces",
    "hyprland/submap",
    "custom/calendar"
  ],
  "modules-center": ["custom/player"],
  "modules-right": [
    "custom/weather",
    "custom/nordvpn",
    "wireplumber",
    //"custom/notification",
    "network",
    "tray",
    "clock",
    //"custom/brightness",
    "battery",
    "custom/power"
  ],
  "include": [
    "~/.config/waybar/modules.json"
  ]
},
  /* Bar for main desktop display */
  {
  "name": "PB287Q",
  "layer": "bottom",
  "position": "top",
  "height": 16,
  "spacing": 3,
  "margin-top": 1,
  "margin-left": 2,
  "margin-right": 2,
  "output": ["Ancor Communications Inc ASUS PB287Q 0x00015C9F"],
  "modules-left": [
    "custom/fuzzel",
    "hyprland/workspaces",
    "hyprland/submap",
    "custom/calendar"
  ],
  "modules-center": ["custom/player"],
  "modules-right": [
    "wireplumber",
    /*"custom/audiocontrol",*/
    "custom/notification",
    "network",
    "custom/nordvpn",
    "custom/weather",
    "clock",
    "custom/timer",
    "custom/brightness",
    "battery",
    "custom/power"
  ],
  "include": [
    "~/.config/waybar/modules.json"
  ]
},
  /* Bar for external ultrawide */
  {
  "name": "ultrawide",
  "layer": "bottom",
  "position": "top",
  "height": 16,
  "spacing": 3,
  "margin-top": 1,
  "margin-left": 2,
  "margin-right": 2,
  "output": ["Samsung Electric Company C49J89x H4ZN300228"],
  "modules-left": [
    "custom/fuzzel",
    "hyprland/workspaces",
    "hyprland/submap",
    "custom/calendar"
  ],
  "modules-center": ["custom/player"],
  "modules-right": [
    "wireplumber",
    /*"custom/audiocontrol",*/
    "custom/notification",
    "network",
    "custom/nordvpn",
    "custom/weather",
    "clock",
    "custom/timer",
    "custom/brightness",
    "battery",
    "custom/power"
  ],
  "include": [
    "~/.config/waybar/modules.json"
  ]
},
  /* Bar for secondary 1440p monitor */
  {
  "name": "secondary",
  "layer": "bottom",
  "position": "top",
  "height": 16,
  "width": 1440,
  "spacing": 3,
  "margin-top": 1,
  "margin-left": 2,
  "margin-right": 2,
  "output": ["Ancor Communications Inc ROG PG279Q HBLMQS061448"],
  "modules-left": [
    "hyprland/window"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "hyprland/workspaces"
  ],
  "include": [
    "~/.config/waybar/modules.json"
  ]
}
]
